---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FeatureGrid from "../components/FeatureGrid.astro";

const kernelFeatures = [
  {
    title: "SMP",
    description: "Multi-core with IPI-based scheduling and cross-core synchronization"
  },
  {
    title: "VFS",
    description: "Unified interface over FAT32, TAR, ProcFS, and SysFS."
  },
  {
    title: "Virtual Terminals",
    description: "10 independent TTYs (/dev/tty1–/dev/tty10), each with its own graphics buffer."
  }
];

const desktopFeatures = [
  {
    title: "Nova Compositor",
    description: "Userland window server over a UNIX socket."
  },
  {
    title: "libui",
    description: "Native UI components for fast, consistent application development."
  },
  {
    title: "Window Management",
    description: "Layered rendering, decorations, focus, and client event routing"
  }
];

const networkFeatures = [
  {
    title: "lwIP stack",
    description: "TCP/UDP stack with DHCP, DNS, ICMP, and a standard sockets API."
  },
  {
    title: "NIC drivers",
    description: "Drivers for Intel E1000, Realtek RTL8139/8111, and VirtIO NICs."
  }
];


---
<BaseLayout title="Features" description="Explore the kernel, desktop, and app tooling that power BoredOS.">
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Kernel"
        title="Kernel internals."
        description="SMP scheduling, memory isolation, and native AHCI drivers for bare-metal SATA storage." />
      <FeatureGrid features={kernelFeatures} layout="balanced-4" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Desktop"
        title="Modern desktop experience."
        description="A stacking window manager, global fuzzy search, and a native UI toolkit built for speed and consistency." />
      <FeatureGrid features={desktopFeatures} layout="balanced-4" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Networking"
        title="Networking stack."
        description="lwIP services with DHCP/DNS/ICMP and NIC driver support for common hardware." />
      <FeatureGrid features={networkFeatures} layout="compact-2" />
    </div>
  </section>
</BaseLayout>
