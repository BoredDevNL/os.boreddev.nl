---
interface Contributor {
  login: string;
  avatar_url: string;
  html_url: string;
  contributions?: number;
  contributionLabel?: string;
  maintainer?: boolean;
}

const { contributors = [] }: { contributors: Contributor[] } = Astro.props;

const formatContribution = (contributor: Contributor): string => {
  if (typeof contributor.contributions === "number") {
    return `${contributor.contributions} contributions`;
  }
  if (contributor.contributionLabel) {
    return contributor.contributionLabel;
  }
  return "Contributor";
};
---
<div class="contributors-grid" data-reveal>
  {contributors.map((contributor) => (
    <a class={`contributor-card${contributor.maintainer ? " contributor-card--maintainer" : ""}`} href={contributor.html_url}>
      {contributor.maintainer && (
        <span class="contributor-badge">Maintainer</span>
      )}
      <img src={contributor.avatar_url} alt={contributor.login} loading="lazy" />
      <strong>{contributor.login}</strong>
      <small>{formatContribution(contributor)}</small>
    </a>
  ))}
</div>

<style>
  .contributor-card {
    position: relative;
  }

  .contributor-card--maintainer {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 8px 24px rgba(31, 111, 235, 0.12);
  }

  .contributor-card--maintainer:hover {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 16px 32px rgba(31, 111, 235, 0.18);
  }

  .contributor-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--accent);
    color: #fff;
  }
</style>